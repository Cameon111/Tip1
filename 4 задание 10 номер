//Даны числа n и m.Создайте массив A[n][m] и заполните его, как показано
//на примере.
//0 1 3 6 10 14 18 22 26 30
//2 4 7 11 15 19 23 27 31 34
//5 8 12 16 20 24 28 32 35 37
//9 13 17 21 25 29 33 36 38 39

#include <iostream>
#include <vector>
using namespace std;

int main() {
    int n, m;
    cin >> n >> m;

    vector<vector<int>> A(n, vector<int>(m));
    int value = 0;

    // Перебираем все диагонали
    for (int d = 0; d < n + m - 1; d++) {
        // Начальная строка
        int row = min(d, n - 1);
        // Начальный столбец
        int col = d - row;

        //вверх по диагонали
        while (row >= 0 && col < m) {
            A[row][col] = value++;
            row--;
            col++;
        }
    }

    // Выводим
    for (int i = 0; i < n; i++) {
        for (int j = 0; j < m; j++) {
            cout << A[i][j] << " ";
        }
        cout << endl;
    }

    return 0;
}
