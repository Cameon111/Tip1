//Программа должна считывать три числа a, b, c, затем программа должна менять их
//значения так, чтобы стали выполнены условия a <= b <= c, затем программа выводит
//тройку a, b, c.

#include<iostream>
#include<vector>
#include<algorithm>
using namespace std;

int main()
{
    setlocale(LC_ALL, "russian");

    cout << "ручной ввод переменных: ";
    int a, b, c;
    cin >> a >> b >> c;
    //создаем вектор и сортируем его
    vector<int> res = { a,b,c };
    sort(res.begin(), res.end());
    for (int r : res) {
        cout << r << " ";
    }
}
