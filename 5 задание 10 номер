//У второклассников очень популярна следующая задача :
//101 = 1
//8181515 = 4
//1111112 = 0
//8888888 = 14
//1010101 = 3
//Преподавателю программирования в некоем Центре для одаренных детей так
//понравилась эта задачка, что он решил именно ее использовать для проверки знаний
//математики 2 - го класса у своих учеников.Пусть первое число x, а соответствующее
//ему n.

#include <iostream>
#include <string>
using namespace std;

int main() {
    string x;
    cin >> x;
    
    //количество кружочков в числе это ответ

    int total = 0;
    for (char c : x) {
        if (c == '0' | c == '6' | c == '9') total += 1;
        else if (c == '8') total += 2;
    }

    cout << total << endl;
    return 0;
}
