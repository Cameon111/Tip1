//Напишите программу, которая считывает два целых числа a и b и выводит
//наибольшее значение из них.Числа — целые от 1 до 1000.
//При решении задачи можно пользоваться только целочисленными
//арифметическими операциями + , -, *, //, %, =. Нельзя пользоваться нелинейными
//конструкциями: ветвлениями, циклами, функциями вычисления модуля, извлечения
//квадратного корня

#include<iostream>

using namespace std;

int main()
{
    setlocale(LC_ALL, "russian");

    //ручной ввод переменных
    int a;
    int b;

    cout << "Введите переменные a,b через пробел: ";
    cin >> a >> b;
    
    //используем разность чисел и применим математическую формулу max(a,b) = a*k + b*(1-k)
    int diff;
    int k;
    diff = a - b;
    k = diff / (diff * diff + 1);
    cout << a * k + b * (1 - k);
}
